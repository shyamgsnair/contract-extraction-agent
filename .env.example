# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres, "Session pooler" URI from Supabase: Connect > Connection string
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Anthropic API key, used only by the paid `api` engine. The free `claude-code` engine never uses it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: path to the Claude Code CLI if `claude` is not on your PATH
# CLAUDE_BIN=/path/to/claude
