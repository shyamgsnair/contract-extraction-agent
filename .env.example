# Copy this file to .env and fill in real values. Never commit .env.

# Supabase Postgres, "Session pooler" URI from Supabase: Connect > Connection string
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Supabase project URL and secret key, for Storage uploads (from Phase 3). Supabase: Project Settings > API Keys.
# The secret key bypasses all access rules: server-side only, never in browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here
# Publishable key, used by the web app for login (Phase 4). Same page, "Publishable key".
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Anthropic API key, used only by the paid `api` engine. The free `claude-code` engine never uses it.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: path to the Claude Code CLI if `claude` is not on your PATH
# CLAUDE_BIN=/path/to/claude
